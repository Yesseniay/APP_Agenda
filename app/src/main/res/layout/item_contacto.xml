<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="?android:attr/selectableItemBackground">

    <!-- Foto de perfil -->
    <ImageView
        android:id="@+id/iv_foto_contacto"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/ic_default_avatar"
        android:scaleType="centerCrop"
        android:background="@drawable/circle_background"
        android:layout_marginEnd="12dp"/>

    <!-- Información del contacto -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Fila superior: Nombre y Favorito -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- CAMBIO: EditText en lugar de TextView -->
            <EditText
                android:id="@+id/et_nombre"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#3F51B5"
                android:hint="Nombre"
                android:background="@android:color/transparent"
                android:padding="4dp"/>

            <!-- Botón Favorito -->
            <ImageButton
                android:id="@+id/btn_favorito"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_favorito_outline"
                android:contentDescription="Marcar como favorito"
                android:padding="8dp"/>

        </LinearLayout>

        <!-- CAMBIO: EditText en lugar de TextView -->
        <EditText
            android:id="@+id/et_numero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="2dp"
            android:hint="Número"
            android:background="@android:color/transparent"
            android:padding="4dp"/>

        <EditText
            android:id="@+id/et_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="2dp"
            android:hint="Email"
            android:background="@android:color/transparent"
            android:padding="4dp"/>

        <EditText
            android:id="@+id/et_notas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="2dp"
            android:hint="Notas"
            android:background="@android:color/transparent"
            android:padding="4dp"/>

        <!-- Botones de acción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="8dp">

            <!-- Botón Llamar -->
            <ImageButton
                android:id="@+id/btn_llamar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_llamar"
                android:contentDescription="Llamar"
                android:padding="8dp"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btn_guardar"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:text="GUARDAR"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#4CAF50"/>

            <Button
                android:id="@+id/btn_editar"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:text="EDITAR"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#FF9800"/>

            <Button
                android:id="@+id/btn_eliminar"
                android:layout_width="wrap_content"
                android:layout_height="35dp"
                android:text="ELIMINAR"
                android:textSize="12sp"
                android:backgroundTint="#F44336"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>